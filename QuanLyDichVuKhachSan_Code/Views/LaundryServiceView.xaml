<UserControl x:Class="QuanLyDichVuKhachSan.LaundryServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="820" d:DesignWidth="1300"
             Background="#F4F6F9" FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="LaundryInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LaundryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="viewGiatUi" Visibility="Visible" Background="#F4F6F9">
        <Grid Margin="20,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. TIÊU ĐỀ & NÚT LÀM MỚI -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#1E293B"/>
                    <TextBlock Text="QUẢN LÝ TIẾN ĐỘ GIẶT ỦI" FontSize="20" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="🔄 Làm Mới Dữ Liệu" HorizontalAlignment="Right"
                        Background="#2563EB" Padding="14,8"
                        Style="{StaticResource LaundryButtonStyle}"
                        Click="BtnLamMoiGiatUi_Click"/>
            </Grid>

            <!-- 2. BA THẺ THỐNG KÊ -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
                <Border Background="White" BorderBrush="#334155" BorderThickness="1.2" CornerRadius="10" Padding="18,14" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="CardLocTatCa_Click">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="ĐƠN ĐÃ TIẾP NHẬN" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                            <TextBlock x:Name="txtTongDonGiatUi" Text="08 đơn" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,2"/>
                            <TextBlock x:Name="txtSubTatCa" Text="✓ Đang xem tất cả" FontSize="11" Foreground="#16A34A" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="📥" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Background="#FEFCE8" BorderBrush="#FDE047" BorderThickness="1.2" CornerRadius="10" Padding="18,14" Margin="4,0,4,0" Cursor="Hand" MouseLeftButtonUp="CardLocDangXuLy_Click">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="ĐANG XỬ LÝ (GIẶT/SẤY/ỦI)" FontSize="11" FontWeight="Bold" Foreground="#A16207"/>
                            <TextBlock x:Name="txtDangXuLyGiatUi" Text="04 đơn" FontSize="24" FontWeight="Bold" Foreground="#CA8A04" Margin="0,4,0,2"/>
                            <TextBlock Text="Bấm để lọc đơn đang giặt/sấy/ủi" FontSize="11" Foreground="#CA8A04"/>
                        </StackPanel>
                        <TextBlock Text="🧺" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1.2" CornerRadius="10" Padding="18,14" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonUp="CardLocChoGiao_Click">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="ĐÃ HOÀN THÀNH / CHỜ GIAO" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"/>
                            <TextBlock x:Name="txtChoGiaoGiatUi" Text="1 đơn" FontSize="24" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,2"/>
                            <TextBlock Text="Bấm để xem đơn chờ giao khách" FontSize="11" Foreground="#EF4444"/>
                        </StackPanel>
                        <TextBlock Text="⚠️" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- 3. THANH QUY TRÌNH 6 BƯỚC -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,14" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="QUY TRÌNH 6 BƯỚC (THEO DÕI TIẾN ĐỘ - BẤM VÀO BƯỚC ĐỂ LỌC)" FontSize="13" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock x:Name="txtTrangThaiLoc" Text="Hiển thị: Tất cả các bước" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <Border Height="3" Background="#CBD5E1" VerticalAlignment="Top" Margin="65,18,65,0"/>
                        <UniformGrid Columns="6">
                            <StackPanel HorizontalAlignment="Center" Cursor="Hand" Tag="Đã tiếp nhận" MouseLeftButtonUp="StepFilter_Click">
                                <Border Width="38" Height="38" CornerRadius="8" Background="#16A34A" HorizontalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="1. Đã tiếp nhận" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center" Cursor="Hand" Tag="Đang giặt" MouseLeftButtonUp="StepFilter_Click">
                                <Border Width="38" Height="38" CornerRadius="8" Background="#0284C7" HorizontalAlignment="Center">
                                    <TextBlock Text="🧺" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="2. Đang giặt" FontSize="12" FontWeight="Bold" Foreground="#0284C7" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center" Cursor="Hand" Tag="Đang sấy" MouseLeftButtonUp="StepFilter_Click">
                                <Border Width="38" Height="38" CornerRadius="8" Background="#D97706" HorizontalAlignment="Center">
                                    <TextBlock Text="☀️" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="3. Đang sấy" FontSize="12" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center" Cursor="Hand" Tag="Đang ủi" MouseLeftButtonUp="StepFilter_Click">
                                <Border Width="38" Height="38" CornerRadius="8" Background="#4F46E5" HorizontalAlignment="Center">
                                    <TextBlock Text="♨️" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="4. Đang ủi" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center" Cursor="Hand" Tag="Hoàn thành" MouseLeftButtonUp="StepFilter_Click">
                                <Border Width="38" Height="38" CornerRadius="8" Background="#DC2626" HorizontalAlignment="Center">
                                    <TextBlock Text="✔" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="5. Hoàn thành" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center" Cursor="Hand" Tag="Đã giao khách" MouseLeftButtonUp="StepFilter_Click">
                                <Border Width="38" Height="38" CornerRadius="8" Background="#475569" HorizontalAlignment="Center">
                                    <TextBlock Text="👥" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="6. Đã giao khách" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,6,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. BẢNG DANH SÁCH ĐƠN & FORM TIẾP NHẬN -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.45*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>

                <!-- BẢNG DANH SÁCH -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="BẢNG DANH SÁCH ĐƠN GIẶT ỦI" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="🔍 Tìm kiếm:" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,8,0" FontSize="12.5"/>
                                <TextBox x:Name="txtTimKiemGiatUi" Width="220"
                                         Style="{StaticResource LaundryInputStyle}"
                                         ToolTip="Nhập Mã đơn, Tên khách hàng hoặc SĐT để tìm..."
                                         TextChanged="TxtTimKiemGiatUi_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="dgDonGiatUi" Grid.Row="1"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0"
                                  RowHeight="44" FontSize="13" SelectionMode="Single"
                                  SelectionChanged="DgDonGiatUi_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã Đơn" Binding="{Binding MaDon}" Width="75" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Tên Khách Hàng" Binding="{Binding TenKhachHang}" Width="1.2*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="SĐT" Binding="{Binding SoDienThoai}" Width="115"/>
                                <DataGridTextColumn Header="Dịch vụ" Binding="{Binding DichVu}" Width="1.15*"/>

                                <DataGridTemplateColumn Header="Trạng thái" Width="125">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding MauNen}" CornerRadius="10" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TrangThai}" Foreground="{Binding MauChu}" FontWeight="Bold" FontSize="11.5"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Tiến độ" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Value="{Binding TienDo}" Minimum="0" Maximum="100" Height="8" Width="70"
                                                         Background="#E2E8F0" Foreground="#0284C7" BorderThickness="0" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Thao tác" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Cập nhật" Background="#C27803" Padding="9,5" Margin="0,0,6,0"
                                                        Style="{StaticResource LaundryButtonStyle}"
                                                        Click="BtnCapNhatTienDo_Click"/>
                                                <Button Content="Lịch sử" Background="#F1F5F9" Foreground="#1E293B" BorderBrush="#94A3B8" BorderThickness="1" Padding="9,5"
                                                        Style="{StaticResource LaundryButtonStyle}"
                                                        Click="BtnLichSuGiatUi_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- FORM TIẾP NHẬN & XỬ LÝ -->
                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="+ TIẾP NHẬN ĐƠN MỚI" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,14"/>

                            <TextBlock Text="Mã Đơn Giặt Ủi:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtMaDonGui" Text="DH009" Style="{StaticResource LaundryInputStyle}" Margin="0,0,0,10"/>

                            <TextBlock Text="Tên Khách Hàng / Số Phòng:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtTenKhachGui" Style="{StaticResource LaundryInputStyle}" Margin="0,0,0,10"/>

                            <TextBlock Text="Số Điện Thoại Khách Hàng:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtSdtGui" Style="{StaticResource LaundryInputStyle}" Margin="0,0,0,10"/>

                            <TextBlock Text="Phân Loại Dịch Vụ Giặt Ủi:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cboLoaiGiatUi" Height="36" FontSize="13" FontWeight="SemiBold" SelectedIndex="0"
                                      VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"
                                      SelectionChanged="CboLoaiGiatUi_SelectionChanged">
                                <ComboBoxItem Content="Giặt sấy thường (Theo kg)" Tag="50.000"/>
                                <ComboBoxItem Content="Giặt ủi cao cấp (Theo bộ)" Tag="85.000"/>
                                <ComboBoxItem Content="Giặt khô / Hấp Vest - Áo dài" Tag="120.000"/>
                                <ComboBoxItem Content="Giặt chăn ga / Đồ vải khách sạn" Tag="150.000"/>
                            </ComboBox>

                            <TextBlock Text="Đơn Giá / Thành Tiền (VNĐ):" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtDonGiaGui" Text="50.000" Style="{StaticResource LaundryInputStyle}" Margin="0,0,0,14"/>

                            <TextBlock Text="Thao tác chức năng:" FontSize="12" Foreground="#64748B" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Height="46" Background="#D97706"
                                        Style="{StaticResource LaundryButtonStyle}"
                                        Click="BtnTiepNhanDon_Click">
                                    <TextBlock Text="TIẾP NHẬN&#x0a;ĐƠN MỚI" TextAlignment="Center" LineHeight="16"/>
                                </Button>

                                <Button Grid.Column="2" Height="46" Background="#1D4ED8"
                                        Style="{StaticResource LaundryButtonStyle}"
                                        Click="BtnChiTietDon_Click">
                                    <TextBlock Text="CHI TIẾT&#x0a;ĐƠN HÀNG" TextAlignment="Center" LineHeight="16"/>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Làm mới Form" Height="36" Background="#D97706"
                                        Style="{StaticResource LaundryButtonStyle}"
                                        Click="BtnLamMoiFormGiatUi_Click"/>

                                <Button Grid.Column="2" Content="✔ Giao Khách" Height="36" Background="#15803D"
                                        Style="{StaticResource LaundryButtonStyle}"
                                        Click="BtnXacNhanGiaoHang_Click"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>