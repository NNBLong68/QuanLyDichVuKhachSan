<Window x:Class="QuanLyDichVuKhachSan.Views.AddFoodItemDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thêm Mặt Hàng Mới - Dalat Hotel"
        Height="650" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Border Background="White" CornerRadius="14" Padding="22" BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.15" Color="#000000"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="➕ THÊM MẶT HÀNG MỚI" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                    <TextBlock Text="Mã mặt hàng sẽ được hệ thống tự sinh sau khi lưu."
                               FontSize="10.5" Foreground="#64748B" FontStyle="Italic" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <!-- Tên Mặt Hàng -->
                    <TextBlock Text="Tên Mặt Hàng (*):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,10"/>

                    <!-- Phân Loại -->
                    <TextBlock Text="Phân Loại Mặt Hàng:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbCategory" Style="{StaticResource ModernComboBox}" Height="34" Margin="0,0,0,10">
                        <ComboBoxItem Content="🍲 Đồ ăn"/>
                        <ComboBoxItem Content="🥤 Thức uống"/>
                    </ComboBox>

                    <!-- ĐVT Bán Lẻ -->
                    <TextBlock Text="Đơn Vị Bán Lẻ (Lon, Chai, Gói, Hộp...):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtRetailUnit" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,10"/>

                    <!-- Giá Bán Lẻ -->
                    <TextBlock Text="Đơn Giá Bán Lẻ (VNĐ):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtPrice" Style="{StaticResource ModernTextBox}" Height="34" FontWeight="Bold" Foreground="#D97706" Margin="0,0,0,10"/>

                    <!-- ĐVT Lúc Nhập & Hệ Số Quy Đổi -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ĐVT Lúc Nhập (Mặc định):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtDefaultImportUnit" Style="{StaticResource ModernTextBox}" Height="34"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hệ Số Quy Đổi Lẻ:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtDefaultConversionRate" Style="{StaticResource ModernTextBox}" Height="34" FontWeight="Bold" Foreground="#0284C7"/>
                        </StackPanel>
                    </Grid>

                    <!-- Ngưỡng cảnh báo tồn kho thấp -->
                    <TextBlock Text="Ngưỡng Cảnh Báo Tồn Kho Thấp (ĐVT bán lẻ):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtLowStockThreshold" Style="{StaticResource ModernTextBox}" Height="34" FontWeight="Bold" Foreground="#B45309" Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy Bỏ" Click="BtnCancel_Click" Height="36" Width="95" Margin="0,0,10,0" Style="{StaticResource OutlineButton}"/>
                        <Button x:Name="BtnSave" Content="➕ Lưu Mặt Hàng" Click="BtnSave_Click" Height="36" Width="140" Style="{StaticResource PrimaryButton}" Background="#16A34A"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
