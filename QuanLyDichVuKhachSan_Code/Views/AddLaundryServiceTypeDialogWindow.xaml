<Window x:Class="QuanLyDichVuKhachSan.Views.AddLaundryServiceTypeDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:QuanLyDichVuKhachSan.Helpers"
        mc:Ignorable="d"
        Title="Thêm Loại Hình Dịch Vụ Giặt Mới - Dalat Hotel"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Grid Margin="16">
        <Border Background="White" CornerRadius="14" Padding="24,20" BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="🧺 THÊM LOẠI HÌNH DỊCH VỤ GIẶT MỚI" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                <TextBlock Text="Chỉ tài khoản Admin mới có quyền thiết lập thêm loại hình &amp; giá niêm yết." FontSize="11" Foreground="#64748B" Margin="0,0,0,16"/>

                <TextBlock Text="Tên Loại Hình Dịch Vụ Giặt (*):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtServiceName" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,12"/>

                <TextBlock Text="Đơn Giá Niêm Yết / Kg (VNĐ) (*):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtRetailPrice" helpers:InputHelper.ValidationMode="DecimalOnly" Style="{StaticResource ModernTextBox}" Height="36" FontWeight="Bold" Foreground="#D97706" Margin="0,0,0,18"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy" Click="BtnCancel_Click" Height="36" Width="90" Margin="0,0,10,0" Style="{StaticResource OutlineButton}"/>
                    <Button Content="Xác nhận" Click="BtnSave_Click" Height="36" Width="120" Style="{StaticResource PrimaryButton}" Background="#16A34A"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

