<Window x:Class="QuanLyDichVuKhachSan.Views.CancelBatchDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hủy Lô Hàng - Dalat Hotel"
        Height="680" Width="1020"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Border Background="White" CornerRadius="14" Padding="20" BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.15" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="🚫 HỦY LÔ HÀNG" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10"
                            Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BatchCount, StringFormat='{}{0} lô trong danh sách'}"
                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#B91C1C"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Tick chọn các lô cần hủy. Lô đã hủy sẽ được giữ lại trong tab Nhập/Hủy kèm lý do."
                           FontSize="10.5" Foreground="#64748B" FontStyle="Italic" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <!-- Cảnh báo tồn kho -->
                <Border x:Name="WarningBorder" Grid.Row="2" Background="#FFFBEB" BorderBrush="#F59E0B"
                        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtWarning" Foreground="#92400E" FontSize="11.5" TextWrapping="Wrap"/>
                </Border>

                <!-- Danh sách lô -->
                <DataGrid x:Name="BatchGrid" Grid.Row="3"
                          AutoGenerateColumns="False" IsReadOnly="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          MinRowHeight="34" RowHeight="NaN"
                          Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,14">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="46" MinWidth="46" IsReadOnly="False">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding AreAllSelected, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip="Chọn tất cả các lô"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Mã phiếu" Binding="{Binding ReceiptCode}" Width="130" MinWidth="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Mặt hàng" Binding="{Binding FoodItemName}" Width="170" MinWidth="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Số lô" Binding="{Binding BatchNumber}" Width="110" MinWidth="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="HSD" Binding="{Binding ExpiryDateDisplay}" Width="95" MinWidth="85" IsReadOnly="True"/>
                        <DataGridTextColumn Header="SL nhập" Binding="{Binding Quantity, StringFormat=N0}" Width="75" MinWidth="70" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ĐVT" Binding="{Binding ImportUnit}" Width="70" MinWidth="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tổng lẻ" Binding="{Binding TotalRetailUnits, StringFormat=N0}" Width="80" MinWidth="75" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tồn hiện tại" Binding="{Binding CurrentStock, StringFormat=N0}" Width="95" MinWidth="85" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="Foreground" Value="#0284C7"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Lý do & ghi chú -->
                <Grid Grid.Row="4" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Lý do hủy (*):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbReason" Style="{StaticResource ModernComboBox}" Height="36"
                                  SelectionChanged="CmbReason_SelectionChanged">
                            <ComboBoxItem Content="Hết hạn"/>
                            <ComboBoxItem Content="Hư hỏng"/>
                            <ComboBoxItem Content="Mất mát"/>
                            <ComboBoxItem Content="Khác"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ghi chú:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtNote" Style="{StaticResource ModernTextBox}" Height="36"
                                 MaxLength="255" ToolTip="Thông tin thêm về lô hàng bị hủy (không bắt buộc)"/>
                    </StackPanel>
                </Grid>

                <!-- Tổng kết & nút -->
                <Grid Grid.Row="5">
                    <TextBlock x:Name="TxtSelection" Text="Chưa chọn lô nào" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="#64748B" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Đóng" Click="BtnClose_Click" Height="36" Width="95" Margin="0,0,10,0"
                                Style="{StaticResource OutlineButton}"/>
                        <Button x:Name="BtnConfirm" Content="🚫 Hủy Lô Đã Chọn" Click="BtnConfirm_Click"
                                Height="36" Width="160" IsEnabled="False"
                                Style="{StaticResource PrimaryButton}" Background="#DC2626"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
