                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DraftItemsCount, StringFormat='{}📋 {0} Mặt hàng | '}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBlock Text="{Binding DraftTotalRetailUnits, StringFormat='{}📦 Tổng tồn lẻ: +{0} đơn vị | '}" FontSize="12" FontWeight="Bold" Foreground="#0284C7"/>
                                <TextBlock Text="{Binding DraftTotalCost, StringFormat='{}💰 Tổng hóa đơn: {0:N0} đ'}" FontSize="13" FontWeight="Bold" Foreground="#D97706"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CommitReceiptCommand}" Content="💾 LẬP PHIẾU &amp; CẬP NHẬT KHO" Style="{StaticResource ModernButton}" Background="#059669" Height="38" Padding="16,0" FontWeight="Bold"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================================================================== -->
            <!-- MÀN 1: KHO HÀNG ĐANG QUẢN LÝ (MẶC ĐỊNH)                                -->
            <!-- ====================================================================== -->
            <Grid x:Name="SubTabWarehouse">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Hidden"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Warehouse">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="IsHitTestVisible" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- BẢNG DANH MỤC HÀNG HÓA (TOÀN CHIỀU RỘNG) -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋 KHO HÀNG ĐANG QUẢN LÝ" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalDryItemsCount, StringFormat='{}{0} mặt hàng'}" FontSize="10.5" FontWeight="Bold" Foreground="#475569"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Width="230" Margin="0,0,8,0" Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="30" ToolTip="Tìm kiếm theo tên mặt hàng..."/>
                                <Button Command="{Binding OpenAddFoodItemDialogCommand}" Content="➕ Thêm mặt hàng" Style="{StaticResource ModernButton}" Height="30" Padding="12,0" Margin="0,0,8,0" Background="#2563EB" FontWeight="SemiBold" ToolTip="Mở form thêm mặt hàng mới"/>
                                <Button Command="{Binding ImportExcelCommand}" Content="📥 Thêm từ Excel" Style="{StaticResource ModernButton}" Height="30" Padding="12,0" Margin="0,0,8,0" Background="#059669" FontWeight="SemiBold" ToolTip="Thêm mặt hàng mới và/hoặc nhập kho từ file Excel"/>
                                <Button x:Name="BtnTrash" Click="BtnTrash_Click" Height="30" Cursor="Hand" Style="{StaticResource ModernButton}" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" Padding="10,0" ToolTip="Thùng rác: khôi phục trong 30 ngày">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🗑️" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Thùng rác" FontSize="11" FontWeight="SemiBold" Foreground="#9F1239" VerticalAlignment="Center"/>
                                        <Border Background="#FFE4E6" CornerRadius="6" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TrashedItemsCount}" FontSize="9.5" FontWeight="Bold" Foreground="#BE123C"/>
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <!-- POPUP CHI TIẾT CÁC MẶT HÀNG BỊ XÓA -->
                                <Popup x:Name="TrashPopup"
                                       PlacementTarget="{Binding ElementName=BtnTrash}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="#FDA4AF" BorderThickness="1.5" CornerRadius="12" Padding="14" Width="380" MaxHeight="420">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header Popup -->
                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🗑️" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="THÙNG RÁC KHO HÀNG" FontSize="12.5" FontWeight="Bold" Foreground="#9F1239" VerticalAlignment="Center"/>
                                                    <Border Background="#FFE4E6" CornerRadius="10" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TrashedItemsCount, StringFormat='{}{0} món'}" FontSize="10" FontWeight="Bold" Foreground="#BE123C"/>
                                                    </Border>
                                                </StackPanel>
                                                <Button Content="✕" Click="BtnCloseTrashPopup_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Width="24" Height="24" Background="Transparent" BorderThickness="0" FontWeight="Bold" Foreground="#94A3B8" Cursor="Hand"/>
                                            </Grid>

                                            <!-- Content Popup -->
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="320">
                                                <StackPanel>
                                                    <!-- Khi thùng rác trống -->
                                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,20"
                                                            Visibility="{Binding HasTrashedItems, Converter={StaticResource InvBoolToVis}}">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="📭" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                            <TextBlock Text="Thùng rác hiện đang trống" FontSize="11.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Các mặt hàng bị xóa sẽ lưu tạm 30 ngày để khôi phục." FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Danh sách mặt hàng khi có món -->
                                                    <ItemsControl ItemsSource="{Binding TrashedItems}"
                                                                  Visibility="{Binding HasTrashedItems, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#FFF1F2" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" BorderBrush="#FECDD3" BorderThickness="1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="{Binding ItemCode}" FontWeight="Bold" FontSize="11.5" Foreground="#B45309" Margin="0,0,6,0"/>
                                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding TrashedDateDisplay}" FontSize="9.5" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <!-- Nút Khôi Phục -->
                                                                            <Button ToolTip="Khôi phục mặt hàng về danh mục kho"
                                                                                    Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1"
                                                                                    Height="28" Padding="8,0" Margin="0,0,4,0" Cursor="Hand"
                                                                                    Command="{Binding DataContext.RestoreFoodItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="♻️" FontSize="11" Margin="0,0,3,0"/>
                                                                                    <TextBlock Text="Khôi phục" FontSize="10.5" FontWeight="Bold" Foreground="#15803D"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <!-- Nút Xóa Vĩnh Viễn -->
                                                                            <Button ToolTip="Xóa vĩnh viễn khỏi CSDL"
                                                                                    Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1"
                                                                                    Height="28" Width="28" Cursor="Hand"
                                                                                    Command="{Binding DataContext.PermanentDeleteFoodItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <TextBlock Text="❌" FontSize="10" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="CatalogDataGrid" Grid.Row="1" ItemsSource="{Binding FilteredCatalogItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                  helpers:TabProgressiveRender.IsDataRegion="True"
                                  MinRowHeight="38"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionMode="Single" MouseDoubleClick="CatalogDataGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✏️ Chỉnh Sửa Mặt Hàng" Click="MenuItem_Edit_Click"/>
                                    <MenuItem Header="🚫 Hủy Lô Hàng" Click="MenuItem_CancelBatches_Click" Foreground="#B45309"/>
                                    <Separator/>
                                    <MenuItem Header="🗑️ Xóa (Chuyển vào Thùng rác)" Click="MenuItem_Trash_Click" Foreground="#DC2626"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource InventoryRowStyle}">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsLowStock}" Value="True"/>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã MH" Binding="{Binding ItemCode}" Width="Auto" MinWidth="90" FontWeight="Bold" Foreground="#475569"/>
                                <DataGridTextColumn Header="Tên Mặt Hàng" Binding="{Binding Name}" Width="Auto" MinWidth="220" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Phân Loại" Binding="{Binding Category}" Width="Auto" MinWidth="105" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="ĐVT Bán Lẻ" Binding="{Binding RetailUnit}" Width="Auto" MinWidth="115"/>
                                <DataGridTextColumn Header="Giá Bán Lẻ" Binding="{Binding Price, StringFormat='{}{0:N0} đ'}" Width="Auto" MinWidth="110" FontWeight="Bold" Foreground="#B45309"/>
                                <DataGridTextColumn Header="Giá Vốn Bình Quân" Binding="{Binding AverageCostPrice, StringFormat='{}{0:N0} đ'}" Width="Auto" MinWidth="160" FontWeight="SemiBold" Foreground="#059669"/>
                                <DataGridTextColumn Header="Tồn Kho Lẻ" Binding="{Binding StockDisplay}" Width="Auto" MinWidth="115" FontWeight="Bold"/>
                                <DataGridTemplateColumn Header="Hạn Sử Dụng (Theo Lô)" Width="280" MinWidth="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,4">
                                                <ItemsControl ItemsSource="{Binding ExpiryLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,1">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#334155"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsNearExpiry}" Value="True">
                                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding ExpiryFallbackText}" FontSize="10" FontStyle="Italic" Foreground="#94A3B8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasExpiryLines}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ngưỡng Báo" Binding="{Binding LowStockThreshold}" Width="Auto" MinWidth="120"/>
                                <DataGridTextColumn Header="ĐVT Nhập Mặc Định" Binding="{Binding DefaultImportUnit}" Width="Auto" MinWidth="170"/>
                                <DataGridTextColumn Header="Hệ Số Quy Đổi" Binding="{Binding DefaultConversionRate}" Width="Auto" MinWidth="135"/>
                                <DataGridTemplateColumn Header="Trạng Thái (Phục Vụ)" Width="Auto" MinWidth="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                <CheckBox IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                          Cursor="Hand"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Status}"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#16A34A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

            </Grid>


            <!-- ====================================================================== -->
            <!-- MÀN 2: HÀNG GẦN HẾT (TỒN KHO <= NGƯỠNG CẢNH BÁO RIÊNG)                 -->
            <!-- ====================================================================== -->
            <Grid x:Name="SubTabLowStock">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Hidden"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="LowStock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="IsHitTestVisible" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="⚠️ MẶT HÀNG GẦN HẾT" FontSize="15" FontWeight="Bold" Foreground="#B45309"/>
                                <TextBlock Text="Tồn kho đã chạm hoặc xuống dưới ngưỡng cảnh báo riêng của từng mặt hàng. Nháy đúp hoặc bấm ⚙️ để chỉnh ngưỡng."
                                           FontSize="10.5" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LowStockItemsCount, StringFormat='{}{0} mặt hàng cần nhập'}" FontSize="11.5" FontWeight="Bold" Foreground="#B45309"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <DataGrid x:Name="LowStockDataGrid" ItemsSource="{Binding LowStockItems}" AutoGenerateColumns="False" IsReadOnly="True"
                                      helpers:TabProgressiveRender.IsDataRegion="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      SelectionMode="Single" MouseDoubleClick="CatalogDataGrid_MouseDoubleClick">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource InventoryRowStyle}">
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã MH" Binding="{Binding ItemCode}" Width="Auto" MinWidth="90" FontWeight="Bold" Foreground="#475569"/>
                                    <DataGridTextColumn Header="Tên Mặt Hàng" Binding="{Binding Name}" Width="Auto" MinWidth="220" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Phân Loại" Binding="{Binding Category}" Width="Auto" MinWidth="105" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Tồn Kho" Binding="{Binding StockDisplay}" Width="Auto" MinWidth="110" FontWeight="Bold" Foreground="#DC2626"/>
                                    <DataGridTextColumn Header="Ngưỡng (ĐVT lẻ)" Binding="{Binding LowStockThreshold}" Width="Auto" MinWidth="140" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Cần Nhập Thêm" Binding="{Binding RestockNeededDisplay}" Width="Auto" MinWidth="140" FontWeight="Bold" Foreground="#B45309"/>
                                    <DataGridTextColumn Header="Giá Bán Lẻ" Binding="{Binding Price, StringFormat='{}{0:N0} đ'}" Width="Auto" MinWidth="110" FontWeight="Bold" Foreground="#B45309"/>
                                    <DataGridTextColumn Header="ĐVT Nhập" Binding="{Binding DefaultImportUnit}" Width="Auto" MinWidth="110"/>
                                    <DataGridTextColumn Header="Hệ Số" Binding="{Binding DefaultConversionRate}" Width="Auto" MinWidth="85"/>
                                    <DataGridTemplateColumn Header="Thao Tác" Width="Auto" MinWidth="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="⚙️ Sửa"
                                                        Command="{Binding DataContext.EditFoodItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1"
                                                        Foreground="#92400E" Height="26" Padding="8,0"
                                                        FontSize="10.5" FontWeight="Bold" Cursor="Hand"
                                                        ToolTip="Chỉnh sửa mặt hàng và ngưỡng cảnh báo"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                                    Visibility="{Binding HasLowStockItems, Converter={StaticResource InvBoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="✅" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Không có mặt hàng nào dưới ngưỡng cảnh báo" FontSize="13" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tồn kho hiện tại của tất cả mặt hàng đều đang ở mức an toàn." FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================================================================== -->
            <!-- MÀN 3: LÔ HÀNG CẬN HẠN SỬ DỤNG (HSD <= HÔM NAY + 7 NGÀY)               -->
            <!-- ====================================================================== -->
            <Grid x:Name="SubTabNearExpiry">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Hidden"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="NearExpiry">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="IsHitTestVisible" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="⏰ LÔ HÀNG CẬN HẠN SỬ DỤNG" FontSize="15" FontWeight="Bold" Foreground="#991B1B"/>
                                <TextBlock Text="Các lô có hạn sử dụng trong 7 ngày tới hoặc đã hết hạn. Tick chọn lô cần hủy, sau đó bấm nút Hủy Lô Đã Chọn."
                                           FontSize="10.5" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                    <TextBlock Text="{Binding NearExpiryBatchesCount, StringFormat='{}{0} lô cận hạn'}" FontSize="11.5" FontWeight="Bold" Foreground="#B91C1C"/>
                                </Border>
                                <Button Content="{Binding SelectedBatchesCount, StringFormat='🚫 Hủy Lô Đã Chọn ({0})'}"
                                        Command="{Binding CancelSelectedBatchesCommand}"
                                        Style="{StaticResource PrimaryButton}" Background="#DC2626"
                                        Height="30" Padding="12,0" Margin="8,0,0,0"
                                        ToolTip="Hủy các lô đang được tick chọn"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <DataGrid ItemsSource="{Binding NearExpiryBatches}" AutoGenerateColumns="False" IsReadOnly="False"
                                      helpers:TabProgressiveRender.IsDataRegion="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      SelectionMode="Single">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource InventoryRowStyle}">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsExpired}" Value="True"/>
                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#FEF2F2"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
